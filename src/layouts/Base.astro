---
import "../styles/auto-complete.css";
import "../styles/Basic.css";
import "../styles/layout.min.css";
import "../styles/animate.min.css";
import "../styles/ke_search_pi1.css";
import "../styles/huaming.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "On-load and de-energized tap changers, vacuum and oil. Technical data as PDF. Shanghai factory, Singapore international headquarters.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/brand/favicon-48.png" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script src="/js/mr/vendor.min.js" is:inline></script>
    <script src="/js/mr/scripts.min.js" is:inline></script>
    <script src="/js/mr/stage.min.js" is:inline></script>
    <script src="/js/mr/text_media_slider.min.js" is:inline></script>
    <script src="/js/mr/numberTicker.min.js" is:inline></script>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        if (window.jQuery) {
          window.jQuery("form[name='form_kesearch_pi1']").off("submit");
        }
      });
    </script>
  </body>
</html>
