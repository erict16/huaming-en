---
import { productBySlug } from "../lib/catalog";

const path = Astro.url.pathname;
const slug = path.match(/^\/products\/([^/]+)\/?$/)?.[1];
const product = slug ? productBySlug(slug) : undefined;
---

{product ? <input id="productName" type="hidden" value={product.name} /> : null}
<a class="skip-link" href="#main">Skip to content</a>
<header class="hm-bar">
  <div class="hm-bar-inner">
    <a class="hm-logo" href="/" aria-label="Huaming home">
      <img src="/brand/logo.png" alt="" width="120" height="36" />
      <span>Huaming</span>
    </a>
    <nav class="hm-primary" aria-label="Primary">
      <a href="/products/" aria-current={path.startsWith("/products") ? "page" : undefined}>Products</a>
      <a href="/about/" aria-current={path.startsWith("/about") ? "page" : undefined}>About</a>
      <a href="/news/" aria-current={path.startsWith("/news") ? "page" : undefined}>News</a>
    </nav>
    <span class="hm-spacer"></span>
    <nav class="hm-util" aria-label="Utility">
      <a href="/news/">News</a>
      <a href="/downloads/">Downloads</a>
      <a href="/contact/">Contact</a>
    </nav>
    <a class="hm-search" href="/search/" aria-label="Search">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
    </a>
    <details class="hm-menu">
      <summary>Menu</summary>
      <nav aria-label="Primary mobile">
        <a href="/products/">Products</a>
        <a href="/about/">About</a>
        <a href="/news/">News</a>
        <a href="/downloads/">Downloads</a>
        <a href="/contact/">Contact</a>
        <a href="/search/">Search</a>
      </nav>
    </details>
  </div>
</header>
