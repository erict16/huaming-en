<canvas
  class="hm-waves absolute inset-0 z-0 block size-full pointer-events-none contain-paint transform-gpu will-change-transform"
  aria-hidden="true"
  data-palette="steel"
></canvas>
<style>
  .hm-waves {
    /* Screen-space fade. Same 16% as the old per-ribbon canvas gradient, one compositor mask. */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 16%, #000 84%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 16%, #000 84%, transparent);
  }
</style>
<script is:inline>
  (function () {
    var canvas = document.querySelector(".hm-waves");
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext("2d", { alpha: true, desynchronized: true }) || canvas.getContext("2d");
    if (!ctx) return;
    var mq = window.matchMedia("(prefers-reduced-motion: reduce)");
    var reduce = mq.matches;
    var buffers = [];
    var normalsBuf = [];
    var hwCache = [];
    var palette = [];
    var palKey = "";
    var backingScale = 1;
    var REST = 1.15;
    var palettes = {
      steel: {
        gradientStart: "#00428C",
        gradientEnd: "#3d86b3",
        opacity: 0.82,
        strokeWidth: 1.16,
        edgeFade: 0.16,
      },
    };
    var named = palettes[canvas.getAttribute("data-palette") || "steel"] || palettes.steel;

    var settings = {
      count: 16,
      resolution: 48,
      spacing: 9.5,
      amplitude: 120,
      frequency: 0.55,
      phase: 0.19,
      twist: 0.36,
      bulge: 0.78,
      morph: 0.22,
      speed: 0.26,
      anim: "flow",
      strokeWidth: named.strokeWidth,
      opacity: named.opacity,
      gradientStart: named.gradientStart,
      gradientEnd: named.gradientEnd,
      edgeFade: named.edgeFade,
      rotate: -6,
      designW: 1600,
      designH: 480,
    };

    function hexRgb(hex) {
      var t = hex.replace("#", "");
      if (t.length === 3) t = t.split("").map(function (c) { return c + c; }).join("");
      return [parseInt(t.slice(0, 2), 16), parseInt(t.slice(2, 4), 16), parseInt(t.slice(4, 6), 16)];
    }

    function offsets(line, u, time) {
      var n = settings.count;
      var phase = settings.phase * (line - (n - 1) / 2);
      var twist = settings.twist;
      var freq = settings.frequency * Math.PI * 2;
      var bulge = 1 + settings.bulge * Math.sin(u * Math.PI);
      var flow = 0;
      var morphT = 0;
      var spin = 0;
      if (settings.anim === "flow") flow = 0.55 * time;
      if (settings.anim === "spin") spin = 0.45 * time;
      var a = Math.sin(freq * u + phase + flow);
      var b = Math.sin(0.5 * freq * u - 2 * phase + 0.7 * flow + spin);
      var morph = 0;
      if (settings.morph > 0) {
        morph = Math.sin(3.7 * u + morphT + 0.2 * line) * Math.cos(2.1 * u - 0.5 * morphT + 0.13 * line);
      }
      return {
        yOffset: (a + twist * b + settings.morph * morph) * 0.5 * bulge,
        lineOffset: ((n <= 1 ? 0.5 : line / (n - 1)) - 0.5) * n * settings.spacing,
      };
    }

    function points(line, time) {
      var steps = Math.max(2, settings.resolution) - 1;
      var buf = buffers[line];
      if (!buf || buf.length !== steps + 1) {
        buf = Array.from({ length: steps + 1 }, function () { return { x: 0, y: 0 }; });
        buffers[line] = buf;
      }
      var midY = settings.designH / 2;
      var rad = (settings.rotate * Math.PI) / 180;
      var cos = Math.cos(rad);
      var sin = Math.sin(rad);
      var midX = settings.designW / 2;
      for (var i = 0; i <= steps; i++) {
        var u = i / steps;
        var off = offsets(line, u, time);
        var x = u * settings.designW;
        var y = midY + off.lineOffset + off.yOffset * settings.amplitude;
        var p = buf[i];
        if (rad === 0) {
          p.x = x;
          p.y = y;
        } else {
          var dx = x - midX;
          var dy = y - midY;
          p.x = midX + dx * cos - dy * sin;
          p.y = midY + dx * sin + dy * cos;
        }
      }
      return buf;
    }

    function normals(pts, line) {
      var n = pts.length;
      var buf = normalsBuf[line];
      if (!buf || buf.length !== n) {
        buf = Array.from({ length: n }, function () { return { x: 0, y: 1 }; });
        normalsBuf[line] = buf;
      }
      for (var i = 0; i < n; i++) {
        var a = pts[Math.max(0, i - 1)];
        var b = pts[Math.min(n - 1, i + 1)];
        var dx = b.x - a.x;
        var dy = b.y - a.y;
        var len = Math.hypot(dx, dy) || 1;
        buf[i].x = -dy / len;
        buf[i].y = dx / len;
      }
      return buf;
    }

    /* Half-width in canvas px. Ends taper; outer ribbons a hair thinner. */
    function halfWidth(u, line) {
      var s = Math.sin(Math.PI * u);
      var belly = s * s;
      var n = settings.count;
      var t = n <= 1 ? 0.5 : line / (n - 1);
      var ring = 0.76 + 0.24 * Math.sin(t * Math.PI);
      return (settings.strokeWidth * backingScale * (0.2 + 0.8 * belly) * ring) / 2;
    }

    function rebuildHw() {
      var n = Math.max(2, settings.resolution);
      hwCache = [];
      for (var line = 0; line < settings.count; line++) {
        var row = new Array(n);
        for (var j = 0; j < n; j++) {
          row[j] = halfWidth(n <= 1 ? 0.5 : j / (n - 1), line);
        }
        hwCache[line] = row;
      }
    }

    function colors() {
      var key = settings.gradientStart + settings.gradientEnd + settings.count + settings.opacity;
      if (key === palKey) return palette;
      palKey = key;
      palette = [];
      var a = hexRgb(settings.gradientStart);
      var b = hexRgb(settings.gradientEnd);
      for (var i = 0; i < settings.count; i++) {
        var t = settings.count <= 1 ? 0 : i / (settings.count - 1);
        var r = Math.round(a[0] + (b[0] - a[0]) * t);
        var g = Math.round(a[1] + (b[1] - a[1]) * t);
        var bl = Math.round(a[2] + (b[2] - a[2]) * t);
        palette.push({
          full: "rgba(" + r + "," + g + "," + bl + "," + settings.opacity + ")",
        });
      }
      return palette;
    }

    function draw(time) {
      var w = settings.designW;
      var h = settings.designH;
      ctx.clearRect(0, 0, w, h);
      var pal = colors();
      var nPts = Math.max(2, settings.resolution);
      if (!hwCache.length || hwCache[0].length !== nPts) rebuildHw();
      for (var i = 0; i < settings.count; i++) {
        var pts = points(i, time);
        if (pts.length < 2) continue;
        var col = pal[i];
        if (!col) continue;
        ctx.fillStyle = col.full;
        var nrm = normals(pts, i);
        var n = pts.length;
        var hw = hwCache[i];
        ctx.beginPath();
        for (var j = 0; j < n; j++) {
          var x = pts[j].x + nrm[j].x * hw[j];
          var y = pts[j].y + nrm[j].y * hw[j];
          if (j === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        for (var k = n - 1; k >= 0; k--) {
          ctx.lineTo(pts[k].x - nrm[k].x * hw[k], pts[k].y - nrm[k].y * hw[k]);
        }
        ctx.closePath();
        ctx.fill();
      }
    }

    function frame(time) {
      draw(time);
    }

    function resize() {
      var box = canvas.getBoundingClientRect();
      var cssW = Math.max(1, box.width);
      var cssH = Math.max(1, box.height);
      /* 1× CSS, width capped at 1280. Old path was DPR 2 (2560×1152 at this viewport). */
      backingScale = Math.min(1, 1280 / cssW);
      var w = Math.max(1, Math.round(cssW * backingScale));
      var h = Math.max(1, Math.round(cssH * backingScale));
      if (canvas.width === w && canvas.height === h) return;
      canvas.width = w;
      canvas.height = h;
      settings.designW = w;
      settings.designH = h;
      settings.amplitude = Math.max(70, h * 0.28);
      rebuildHw();
    }

    var start = 0;
    var raf = 0;
    var running = false;
    var pausedAt = 0;
    var visible = true;
    function nowTime() {
      if (!start) return REST;
      return ((performance.now() - start) / 1000) * settings.speed;
    }

    function tick(now) {
      if (!start) start = now;
      frame(((now - start) / 1000) * settings.speed);
      raf = requestAnimationFrame(tick);
    }

    function play() {
      if (reduce || !visible || document.hidden) return;
      if (running) return;
      running = true;
      if (pausedAt) {
        start += performance.now() - pausedAt;
      }
      raf = requestAnimationFrame(tick);
    }

    function stop() {
      if (!running) return;
      running = false;
      cancelAnimationFrame(raf);
      pausedAt = performance.now();
    }

    function still() {
      stop();
      frame(REST);
    }

    function onReduceChange() {
      reduce = mq.matches;
      if (reduce) still();
      else play();
    }

    resize();
    if (reduce) {
      still();
    }

    if (mq.addEventListener) mq.addEventListener("change", onReduceChange);
    else if (mq.addListener) mq.addListener(onReduceChange);

    var ro = new ResizeObserver(function () {
      resize();
      if (!running) frame(reduce ? REST : nowTime());
    });
    ro.observe(canvas);

    var io = new IntersectionObserver(
      function (entries) {
        visible = !!(entries[0] && entries[0].isIntersecting);
        if (visible) play();
        else stop();
      },
      { rootMargin: "10% 0px" }
    );
    io.observe(canvas);

    document.addEventListener("visibilitychange", function () {
      if (document.hidden) stop();
      else play();
    });
  })();
</script>
