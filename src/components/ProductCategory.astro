---
import Base from "../layouts/Base.astro";
import InnerTeaser from "./InnerTeaser.astro";
import ProductBox from "./ProductBox.astro";
import ProductTabs from "./ProductTabs.astro";
import StageControls from "./StageControls.astro";
import { families, type Product } from "../lib/catalog";
import { productImageSrc } from "../lib/product-image";

interface Crumb {
  href: string;
  label: string;
}

interface TableGroup {
  className: string;
  heading?: string | null;
  items: Product[];
}

interface Props {
  title: string;
  description: string;
  blurb: string;
  crumbs: Crumb[];
  items: Product[];
  tableGroups?: TableGroup[];
}

const { title, description, blurb, crumbs, items, tableGroups } = Astro.props;
const stageSrc = items.map((p) => productImageSrc(p.slug)).find(Boolean) ?? null;
const groups: TableGroup[] = (
  tableGroups && tableGroups.length
    ? tableGroups
    : [{ className: "table-gradient", heading: null, items }]
).filter((g) => g.items.length);
const rows = items.map((p) => ({
  p,
  fam: families.find((f) => f.id === p.family),
}));
---

<Base title={`${title} · Huaming`} description={description}>
  <main id="main">
    {
      stageSrc ? (
        <div class="frame frame-default frame-type-sitereinhausen_stage frame-layout-0">
        <div class="stage">
          <div class="swiper-container stage-slider" data-loop="0" data-autoplay="0" data-autoplay-time="5000">
            <div class="swiper-wrapper">
              <div class="swiper-slide">
                <div class="swiper-image">
                  <img src={stageSrc} alt="" width="600" height="414" />
                </div>
                <div class="stage-content container bg-gradient">
                  <div class="text-container">
                    <h2>
                      <p>{title}</p>
                    </h2>
                    <span class="light">
                      <p>{blurb}</p>
                    </span>
                  </div>
                </div>
              </div>
            </div>
            <StageControls />
          </div>
        </div>
        </div>
      ) : null
    }

    <div class="hm-list hm-list-family">
      <div class="hm-wrap hm-list-intro">
        <h1>{title}</h1>
        <p class="hm-list-lede">{blurb}</p>
        <ProductTabs
          current={
            crumbs.some((c) => c.href.includes("/oltc"))
              ? "oltc"
              : crumbs.some((c) => c.href.includes("/octc"))
                ? "octc"
                : crumbs.some((c) => c.href.includes("/accessories"))
                  ? "accessories"
                  : "all"
          }
        />
      </div>
    </div>

    <slot />

    <div class="hm-wrap hm-spec-intro">
      <h2>Types in this family</h2>
      <p>
        Type, kind, and a PDF link. Brochure wins if the shop text disagrees.{" "}
        <a href="/downloads/">Downloads</a>
      </p>
    </div>

    {
      groups.map((g) => (
        <div class="hm-wrap hm-spec">
          {g.heading ? <h3>{g.heading}</h3> : null}
          <div class="hm-spec-scroll">
            <table>
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Kind</th>
                  <th>Note</th>
                  <th>PDF</th>
                </tr>
              </thead>
              <tbody>
                {g.items.map((p) => {
                  const fam = families.find((f) => f.id === p.family);
                  return (
                    <tr>
                      <td>
                        <a href={`/products/${p.slug}/`}>{p.name}</a>
                      </td>
                      <td>{fam?.name}</td>
                      <td>{p.oneLiner}</td>
                      <td>
                        <a href="/downloads/">Technical data</a>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }

    <div class="hm-wrap hm-family-stills">
      <div class="product-list-plugin">
        <div id="portfolio-overview-products" class="grid">
          {
            rows.map(({ p, fam }) => (
              <ProductBox
                href={`/products/${p.slug}/`}
                name={p.name}
                intro={p.oneLiner}
                image={productImageSrc(p.slug)}
                facts={[...(p.ratings ?? []).slice(0, 3), fam?.name ?? ""]}
              />
            ))
          }
        </div>
      </div>
    </div>
    <InnerTeaser />
  </main>
</Base>
