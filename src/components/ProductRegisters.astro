---
import type { Download } from "../lib/catalog";
import ProductRatingTable from "./ProductRatingTable.astro";
import ProductDownloadRows from "./ProductDownloadRows.astro";

interface Props {
  slug: string;
  ratings: string[];
  files: Download[];
  noPdf?: boolean;
  note?: string | null;
}

const { slug, ratings, files, noPdf = false, note = null } = Astro.props;
const id = slug.replace(/[^a-z0-9-]/gi, "");
---

<div class="product-registers-container">
  <div class="container">
    <div class="row">
      <div class="col-m-12 col">
        <div class="accordion accordion-js" id={`accordion-${id}`}>
          <h2 class="headline">Product Information</h2>

          <div class="d-none d-md-flex row" data-js-register="true">
            <div class="col-4">
              <div class="nav flex-column nav-pills" id={`v-pills-tab-${id}`} role="tablist" aria-orientation="vertical">
                <a
                  class="nav-link active"
                  id={`v-pills-${id}-tab`}
                  data-toggle="pill"
                  href={`#v-pills-${id}`}
                  role="tab"
                  aria-controls={`v-pills-${id}`}
                  aria-selected="true">Technical Data</a
                >
                <a
                  class="nav-link"
                  id={`v-pills-dl-${id}-tab`}
                  data-toggle="pill"
                  href={`#v-pills-dl-${id}`}
                  role="tab"
                  aria-controls={`v-pills-dl-${id}`}
                  aria-selected="false">Downloads</a
                >
              </div>
            </div>
            <div class="col-8">
              <div class="tab-content" id={`v-pills-tabContent-${id}`}>
                <div
                  class="tab-pane fade show active"
                  id={`v-pills-${id}`}
                  role="tabpanel"
                  aria-labelledby={`v-pills-${id}-tab`}
                >
                  <ProductRatingTable ratings={ratings} />
                </div>
                <div
                  class="tab-pane fade"
                  id={`v-pills-dl-${id}`}
                  role="tabpanel"
                  aria-labelledby={`v-pills-dl-${id}-tab`}
                >
                  <ProductDownloadRows id={`${id}-desk`} files={files} noPdf={noPdf} note={note} />
                </div>
              </div>
            </div>
          </div>

          <div class="d-block d-md-none">
            <div class="card">
              <div
                class="card-header"
                id={`heading-0-${id}`}
                data-toggle="collapse"
                data-target={`#collapse-0-${id}`}
                aria-expanded="false"
                aria-controls={`collapse-0-${id}`}
                role="button"
              >
                <div class="h4">Technical Data</div>
                <div class="a-open">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9 11V20H11V11H20V9H11V0H9V9H0V11H9Z" fill="#002A55"
                    ></path>
                  </svg>
                </div>
                <div class="a-clos">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 10H20" stroke="#002A55" stroke-width="2"></path>
                  </svg>
                </div>
              </div>
              <div id={`collapse-0-${id}`} class="collapse" aria-labelledby={`heading-0-${id}`}>
                <div class="card-body">
                  <ProductRatingTable ratings={ratings} />
                </div>
              </div>
            </div>

            <div class="card download-center">
              <div
                class="card-header collapsed"
                id={`heading-downloads-${id}`}
                data-toggle="collapse"
                data-target={`#collapse-downloads-${id}`}
                aria-expanded="false"
                aria-controls={`collapse-downloads-${id}`}
                role="button"
              >
                <div class="h4">Downloads</div>
                <div class="a-open">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M9 11V20H11V11H20V9H11V0H9V9H0V11H9Z" fill="#002A55"
                    ></path>
                  </svg>
                </div>
                <div class="a-clos">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0 10H20" stroke="#002A55" stroke-width="2"></path>
                  </svg>
                </div>
              </div>
              <div id={`collapse-downloads-${id}`} class="collapse" aria-labelledby={`heading-downloads-${id}`}>
                <div class="card-body">
                  <ProductDownloadRows id={`${id}-mob`} files={files} noPdf={noPdf} note={note} wrapCenter={false} />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
