---
import Base from "../layouts/Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { offices } from "../lib/catalog";
---

<Base title="About · Huaming" description="Shanghai Huaming Power Equipment Co., Ltd. makes tap changers for power transformers.">
  <main id="main">
    <div class="frame frame-default frame-type-sitereinhausen_introtext frame-layout-0">
      <div class="introtext bg-white">
        <div class="container">
          <Breadcrumb crumbs={[{ href: "/", label: "Home" }]} visible={false} />
          <div>
            <h1 class="h1ToIntro">About Huaming</h1>
          </div>
          <div class="row">
            <div class="intro col-xl-12 col-xxl-10">
              <p>
                Shanghai factory. Singapore international headquarters. Tap changers for power
                transformers: on-load and de-energized, vacuum and oil, plus the motor drive.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="frame frame-default frame-type-sitereinhausen_text frame-layout-0">
      <div class="text-module bg-white" style="position: relative;">
        <div class="container">
          <div class="row">
            <div class="col-12 col-sm-6 col-lg-5 offset-lg-1">
              <h2 class="headline mb-sm-0">Shanghai factory. Singapore international headquarters.</h2>
            </div>
            <div class="col-12 col-sm-6 col-lg-5">
              <div class="text-wrapper">
                <p>
                  Legal name: Shanghai Huaming Power Equipment Co., Ltd. Credit code 913101076076323035.
                  Factory at No. 977 Tongpu Road, Putuo District, Shanghai 200333. International mail:
                  <a href="mailto:intl@huaming.com">intl@huaming.com</a>.
                </p>
                <p>
                  International headquarters: Huaming Power Equipment Singapore Pte. Ltd, Tai Seng Exchange
                  (TSX) Tower A #03-13, 1 Tai Seng Ave, Singapore 536464. The company announced that office
                  on 29 April 2025.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
      <div class="numbers-module bg-grey">
        <div class="container">
          <div class="number-headline">
            <h2>Figures, data, facts</h2>
          </div>
          <div class="numbers row three-column three-column-sm">
            <div class="col-12 col-xxl-10 offset-xxl-1">
              <div class="row justify-content-sm-center justify-content-md-start">
                <div class="number three-column col-12 col-md-4 three-column-sm col-sm-4">
                  <span class="number-overline bolder">Founded</span>
                  <span class="number-number"><span class="val">1989</span></span>
                  <p class="number-label">Shanghai. History page starts the listed subsidiary in 1995.</p>
                </div>
                <div class="number three-column col-12 col-md-4 three-column-sm col-sm-4">
                  <span class="number-overline bolder">Countries</span>
                  <span class="number-number"><span class="val">150</span></span>
                  <p class="number-label">Tap changers in 150+ countries (chairman letter).</p>
                </div>
                <div class="number three-column col-12 col-md-4 three-column-sm col-sm-4">
                  <span class="number-overline bolder">Lead time</span>
                  <span class="number-number"><span class="val">6</span></span>
                  <p class="number-label">About 4–6 weeks, standard.</p>
                </div>
                <div class="number three-column col-12 col-md-4 three-column-sm col-sm-4">
                  <span class="number-overline bolder">Listed</span>
                  <span class="number-number"><span class="val">2015</span></span>
                  <p class="number-label">Shenzhen 002270.SZ. Changzheng Electric 2018.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <div class="frame frame-default frame-type-sitereinhausen_text frame-layout-0">
      <div class="text-module bg-white" style="position: relative;">
        <div class="container">
          <div class="row">
            <div class="col-12 col-sm-6 col-lg-5 offset-lg-1">
              <h2 class="headline">Also</h2>
            </div>
            <div class="col-12 col-sm-6 col-lg-5">
              <div class="text-wrapper">
                <p>Chairman: Xiao Yi (肖毅), general manager since 1995.</p>
                <p>CNAS laboratory accreditation, 2009. Public pages list ISO 9001, ISO 14001, and ISO 18001.</p>
                <p>Turkey plant 2016. Brazil and USA outlets 2019. Singapore subsidiary 2022. Indonesia plant 2025.</p>
                <p>CHVT at Longdong ±800 kV HVDC, commissioned 28 May 2025.</p>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-5 offset-lg-1">
              <h2 class="headline">Offices</h2>
            </div>
            <div class="col-12 col-sm-6 col-lg-5">
              <div class="text-wrapper">
                {
                  offices.map((o) => (
                    <p>
                      <strong>{o.name}</strong>
                      {` ${o.role}. `}
                      {o.lines.join(", ")}
                    </p>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Base>
