---
import Base from "../layouts/Base.astro";
import InnerTeaser from "../components/InnerTeaser.astro";
import { products } from "../lib/catalog";
import { allDownloads } from "../lib/downloads";
import { news } from "../lib/news";

const rows = [
  ...products.map((p) => ({
    href: `/products/${p.slug}/`,
    title: p.name,
    teaser: p.oneLiner,
    type: "page" as const,
  })),
  ...allDownloads().map((d) => ({
    href: `/downloads/${d.file}`,
    title: d.title,
    teaser: d.file,
    type: "file" as const,
  })),
  ...news.map((n) => ({
    href: `/news/${n.slug}/`,
    title: n.title,
    teaser: n.summary,
    type: "page" as const,
  })),
];
---

<Base title="Search · Huaming" description="Search types, PDFs, and news.">
  <main id="main" class="hm-list hm-search-page">
    <div class="hm-wrap hm-list-intro">
      <h1>Search</h1>
      <p class="hm-list-lede">Types, PDFs, and news. Two characters or more.</p>
      <form class="hm-docs-search" method="get" action="/search/" id="form_kesearch_pi1">
        <label class="hm-label" for="ke_search_sword">
          Query
          <input
            class="hm-field ke_search_sword_search"
            type="search"
            id="ke_search_sword"
            name="q"
            required
            minlength="2"
            placeholder="CM2, SHZV, Longdong…"
          />
        </label>
        <button class="hm-submit" type="submit">Search</button>
        <p id="resultCounterInfo" hidden>
          <span id="countedResults">0</span> results
          <span id="searchWord"></span>
        </p>
        <input id="resultCounter" type="hidden" value="0" />
      </form>
    </div>
    <div class="hm-wrap hm-results" id="kesearch_results">
      {
        rows.map((r) => (
          <div class="hm-result" data-search={`${r.title} ${r.teaser} ${r.href}`.toLowerCase()} hidden>
            <a href={r.href}>{r.title}</a>
            <p>{r.teaser}</p>
          </div>
        ))
      }
      <p class="hm-load-more" id="load-more" hidden>
        <button class="hm-submit" type="button">Show more</button>
      </p>
    </div>
    <InnerTeaser />
  </main>
</Base>

<script is:inline>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var raw = (params.get("q") || "").trim();
    var q = raw.toLowerCase();
    document.querySelectorAll(".ke_search_sword_search").forEach(function (el) {
      if (raw) el.value = raw;
    });
    var items = Array.from(document.querySelectorAll("#kesearch_results .hm-result"));
    var more = document.getElementById("load-more");
    var PAGE = 10;
    var shown = 0;
    items.forEach(function (el) {
      var hay = el.getAttribute("data-search") || "";
      var hit = q.length >= 2 && hay.indexOf(q) !== -1;
      if (!hit) {
        el.hidden = true;
        return;
      }
      shown += 1;
      el.hidden = shown > PAGE;
    });
    if (more) more.hidden = shown <= PAGE;
    document.querySelectorAll("#countedResults").forEach(function (el) {
      el.textContent = String(shown);
    });
    document.querySelectorAll("#searchWord").forEach(function (el) {
      el.textContent = q.length >= 2 ? raw : "";
    });
    var counter = document.getElementById("resultCounter");
    if (counter) counter.value = String(shown);
    document.querySelectorAll("#resultCounterInfo").forEach(function (el) {
      el.hidden = shown === 0;
    });
    if (more) {
      more.addEventListener("click", function () {
        items.forEach(function (el) {
          var hay = el.getAttribute("data-search") || "";
          var hit = q.length >= 2 && hay.indexOf(q) !== -1;
          if (hit) el.hidden = false;
        });
        more.hidden = true;
      });
    }
  })();
</script>
