---
import Base from "../layouts/Base.astro";
import SearchBox from "../components/SearchBox.astro";
import { products } from "../lib/catalog";
import { allDownloads } from "../lib/downloads";
import { news } from "../lib/news";

const rows = [
  ...products.map((p) => ({
    href: `/products/${p.slug}/`,
    title: p.name,
    teaser: p.oneLiner,
    type: "page" as const,
  })),
  ...allDownloads().map((d) => ({
    href: `/downloads/${d.file}`,
    title: d.title,
    teaser: d.file,
    type: "file" as const,
  })),
  ...news.map((n) => ({
    href: `/news/${n.slug}/`,
    title: n.title,
    teaser: n.summary,
    type: "page" as const,
  })),
];
---

<Base title="Search · Huaming" description="Search types, PDFs, and news.">
  <main id="main">
    <SearchBox />

    <div class="frame frame-default frame-type-ke_search_pi2 frame-layout-0">
      <div class="tx-kesearch-pi1">
        <div class="container">
          <input type="hidden" id="resultCounter" value="0" />
          <div id="kesearch_results">
            {
              rows.map((r, i) => (
                <div
                  class={`result-list-item result-list-item-type-${r.type}`}
                  data-search={`${r.title} ${r.teaser} ${r.href}`.toLowerCase()}
                  hidden
                >
                  <div class="result-number">{i + 1}.</div>
                  <div class="result-title result-title-page">
                    <a href={r.href}>{r.title}</a>
                  </div>
                  <div class="result-teaser">{r.teaser}</div>
                  <div class="add-info">{r.type}</div>
                </div>
              ))
            }
            <div class="load-more">
              <div class="content">Show more</div>
            </div>
          </div>
          <div id="kesearch_pagebrowser_bottom"></div>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        const params = new URLSearchParams(window.location.search);
        const raw = (params.get("q") || "").trim();
        const q = raw.toLowerCase();
        document.querySelectorAll(".ke_search_sword_search").forEach(function (el) {
          if (raw) el.value = raw;
        });
        document.querySelectorAll("main .resetButton").forEach(function (el) {
          el.addEventListener("click", function () {
            window.location.href = "/search/";
          });
        });
        const items = Array.from(document.querySelectorAll("#kesearch_results .result-list-item"));
        const more = document.querySelector("#kesearch_results .load-more");
        const PAGE = 10;
        let shown = 0;
        items.forEach(function (el) {
          const hay = el.getAttribute("data-search") || "";
          const hit = q.length >= 2 && hay.indexOf(q) !== -1;
          if (!hit) {
            el.hidden = true;
            return;
          }
          shown += 1;
          const num = el.querySelector(".result-number");
          if (num) num.textContent = shown + ".";
          el.hidden = shown > PAGE;
        });
        if (more) more.hidden = shown <= PAGE;
        document.querySelectorAll("#countedResults").forEach(function (el) {
          el.textContent = String(shown);
        });
        document.querySelectorAll("#searchWord").forEach(function (el) {
          el.textContent = q.length >= 2 ? raw : "";
        });
        const counter = document.getElementById("resultCounter");
        if (counter) counter.value = String(shown);
        document.querySelectorAll("#resultCounterInfo").forEach(function (el) {
          el.style.display = shown > 0 ? "block" : "none";
        });
        if (more) {
          more.addEventListener("click", function () {
            items.forEach(function (el) {
              const hay = el.getAttribute("data-search") || "";
              const hit = q.length >= 2 && hay.indexOf(q) !== -1;
              if (hit) el.hidden = false;
            });
            more.hidden = true;
          });
        }
      })();
    </script>
  </main>
</Base>
