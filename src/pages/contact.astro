---
import Base from "../layouts/Base.astro";
import InnerTeaser from "../components/InnerTeaser.astro";
import { offices } from "../lib/catalog";

const shanghai = offices.find((o) => o.id === "shanghai");
const singapore = offices.find((o) => o.id === "singapore");
const others = offices.filter((o) => o.id !== "shanghai" && o.id !== "singapore");
---

<Base title="Contact · Huaming" description="International inquiries: intl@huaming.com. Singapore is the international headquarters. Shanghai is the factory.">
  <main id="main" class="hm-list hm-contact">
    <div class="hm-wrap hm-list-intro">
      <h1>Contact</h1>
      <p class="hm-list-lede">
        International inquiries:{" "}
        <a href="mailto:intl@huaming.com">intl@huaming.com</a>. Singapore is the international
        headquarters. Shanghai is the factory.
      </p>
    </div>

    <div class="hm-wrap hm-offices">
      {
        [singapore, shanghai].filter(Boolean).map((o) => (
          <article>
            <p class="hm-place">{o!.role}</p>
            <h2>{o!.name}</h2>
            {o!.lines.map((line) => (
              <p>{line}</p>
            ))}
            {"email" in o! && o!.email ? (
              <p>
                <a href={`mailto:${o!.email}`}>{o!.email}</a>
              </p>
            ) : null}
          </article>
        ))
      }
    </div>

    <form class="hm-wrap hm-form" method="post" action="mailto:intl@huaming.com" enctype="text/plain">
      <h2>Write Singapore</h2>
      <label class="hm-label">
        Name
        <input class="hm-field" required name="name" autocomplete="name" />
      </label>
      <label class="hm-label">
        Email
        <input class="hm-field" required type="email" name="email" autocomplete="email" />
      </label>
      <label class="hm-label">
        About
        <select class="hm-field" name="about">
          <option value="OLTC">On-load tap changer</option>
          <option value="OCTC">De-energized tap changer</option>
          <option value="Accessories">Motor drive / monitor</option>
          <option value="Brochure">Brochure</option>
          <option value="Other">Other</option>
        </select>
      </label>
      <label class="hm-label">
        Office
        <select class="hm-field" name="office">
          <option value="Singapore">Singapore HQ</option>
          <option value="Shanghai">Shanghai factory</option>
          <option value="Other">Other</option>
        </select>
      </label>
      <label class="hm-label">
        Company
        <input class="hm-field" name="company" autocomplete="organization" />
      </label>
      <label class="hm-label">
        Telephone
        <input class="hm-field" type="tel" name="phone" autocomplete="tel" />
      </label>
      <label class="hm-label">
        Message
        <textarea class="hm-field" required name="message" rows="5"></textarea>
      </label>
      <label class="hm-check">
        <input required type="checkbox" name="privacy" value="ok" />
        I have read the <a href="/legal/privacy/">Privacy</a> page.
      </label>
      <button class="hm-submit" type="submit">Send to intl@huaming.com</button>
      <p class="hm-form-note">This form opens your mail app. It does not post to a server.</p>
    </form>

    {
      others.length ? (
        <div class="hm-wrap">
          <h2 class="hm-more-h">Other offices</h2>
          <div class="hm-offices">
            {others.map((o) => (
              <article>
                <p class="hm-place">{o.role}</p>
                <h2>{o.name}</h2>
                {o.lines.map((line) => (
                  <p>{line}</p>
                ))}
                {"email" in o && o.email ? (
                  <p>
                    <a href={`mailto:${o.email}`}>{o.email}</a>
                  </p>
                ) : null}
              </article>
            ))}
          </div>
        </div>
      ) : null
    }
    <InnerTeaser />
  </main>
</Base>
