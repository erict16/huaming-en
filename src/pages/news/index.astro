---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SwiperArrows from "../../components/SwiperArrows.astro";
import { news, newsBandSrc } from "../../lib/news";
---

<Base title="News · Huaming" description="Articles listed on the live English newsroom. Titles rewritten. No extra stories invented.">
  <main id="main">
    <div class="frame frame-default frame-type-sitereinhausen_introtext frame-layout-0">
      <div class="introtext bg-white">
        <div class="container">
          <Breadcrumb crumbs={[{ href: "/", label: "Home" }]} visible={false} />
          <div>
            <h1 class="h1ToIntro">News</h1>
          </div>
          <div class="row">
            <div class="intro col-xl-12 col-xxl-10">
              <p>From the live English newsroom. We rewrote the titles. We did not invent extra stories.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="bg-">
      <div class="teaser_articles left">
        <div class="container">
          <div class="row">
            <div class="article-main-area col-lg-12 col-xl-6">
              <div class="blue-teaser bg-gradient">
                <div class="content">
                  <h2>{news[0].title}</h2>
                  <p>{news[0].summary}</p>
                  <a class="cta cta-outline cta-outline-white mb-0" href={`/news/${news[0].slug}/`}>
                    Learn more
                  </a>
                </div>
              </div>
            </div>
            <div class="article-slider-area col-lg-12 col-xl-6">
              <div class="swiper-container swiper-articles" id="1" data-initialSlide="0">
                <SwiperArrows prevClass="swiper-button-prev1" nextClass="swiper-button-next1" />
                <div class="swiper-wrapper">
                  {
                    news.slice(1).map((item) => (
                      <div class="swiper-slide">
                        <a href={`/news/${item.slug}/`} class="link-wrap">
                          <div class="articleWrapper">
                            <div class="articleImage media-16-9">
                              {
                                newsBandSrc(item.slug) ? (
                                  <img
                                    class="media-element-image no-crop"
                                    src={newsBandSrc(item.slug)!}
                                    alt=""
                                  />
                                ) : null
                              }
                            </div>
                            <div class="swiper-text-container">
                              <div class="swiper-text">
                                <p>{item.date}</p>
                                <h3>{item.title}</h3>
                                <p>{item.summary}</p>
                              </div>
                            </div>
                          </div>
                        </a>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="frame frame-default frame-type-sitereinhausen_teaser frame-layout-0">
      <div class="teaser-module bg-white">
        <div class="container">
          <div class="row">
            <div class="text col-m-12 col-lg-12">
              <div class="teaser-wrapper">
                <div class="row">
                  <div class="teaser_element col-lg-4 three-column">
                    <div class="textteaser textteaser-gradient textteaser-gradient-bg">
                      <div class="teaser-HeadlineAndText">
                        <p class="headline">Technical data as PDF?</p>
                      </div>
                      <div>
                        <a href="/downloads/" class="link">Downloads</a>
                      </div>
                    </div>
                  </div>
                  <div class="teaser_element col-lg-4 three-column">
                    <div class="textteaser textteaser-gradient textteaser-gradient-bg">
                      <div class="teaser-HeadlineAndText">
                        <p class="headline">Types. Brochures.</p>
                      </div>
                      <div>
                        <a href="/products/" class="link">Products</a>
                      </div>
                    </div>
                  </div>
                  <div class="teaser_element col-lg-4 three-column">
                    <div class="textteaser textteaser-gradient textteaser-gradient-bg">
                      <div class="teaser-HeadlineAndText">
                        <p class="headline">International mail is Singapore.</p>
                      </div>
                      <div>
                        <a href="/contact/" class="link">Find a contact</a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Base>
