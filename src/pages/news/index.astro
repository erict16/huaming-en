---
import Base from "../../layouts/Base.astro";
import InnerTeaser from "../../components/InnerTeaser.astro";
import { news } from "../../lib/news";
---

<Base title="News · Huaming" description="Articles listed on the live English newsroom. Titles rewritten. No extra stories invented.">
  <main id="main" class="hm-list">
    <div class="hm-wrap hm-list-intro">
      <h1>News</h1>
      <p class="hm-list-lede">
        From the live English newsroom. Titles rewritten. No extra stories invented.
      </p>
    </div>
    <section class="hm-news" aria-label="News">
      <div class="hm-wrap">
        <ul>
          {
            news.map((item, i) => (
              <li>
                <span class="hm-n">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <a href={`/news/${item.slug}/`}>{item.title}</a>
                  <p>{item.summary}</p>
                </div>
                <time datetime={item.date}>{item.date}</time>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
    <InnerTeaser />
  </main>
</Base>
