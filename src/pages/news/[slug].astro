---
import Base from "../../layouts/Base.astro";
import InnerTeaser from "../../components/InnerTeaser.astro";
import { news, newsArticlePhoto, newsBySlug } from "../../lib/news";

export function getStaticPaths() {
  return news.map((n) => ({ params: { slug: n.slug } }));
}

const item = newsBySlug(Astro.params.slug!);
if (!item) throw new Error("unknown news");
const photo = newsArticlePhoto(item.slug);
---

<Base title={`${item.title} · Huaming`} description={item.summary}>
  <main id="main" class="hm-list hm-article">
    <div class="hm-wrap hm-list-intro">
      <p class="hm-pdp-kicker">
        <a href="/news/">News</a>
        {" · "}
        <time datetime={item.date}>{item.date}</time>
      </p>
      <h1>{item.title}</h1>
      <p class="hm-list-lede">{item.summary}</p>
    </div>
    {
      photo ? (
        <figure class="hm-wrap hm-article-photo">
          <img src={photo} alt="" />
        </figure>
      ) : null
    }
    <div class="hm-wrap hm-article-body">
      {item.body.map((p) => (
        <p>{p}</p>
      ))}
      {
        item.figures?.length ? (
          <dl class="hm-facts">
            {item.figures.map((f) => (
              <div>
                <dt>
                  {f.val}
                  {f.unit ? ` ${f.unit}` : ""}
                </dt>
                <dd>{f.label}</dd>
              </div>
            ))}
          </dl>
        ) : null
      }
      <p class="hm-list-pdf">
        <a href="/news/">All news</a>
      </p>
    </div>
    <InnerTeaser />
  </main>
</Base>
