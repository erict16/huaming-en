---
import Base from "../layouts/Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import InnerTeaser from "../components/InnerTeaser.astro";
import ProductDownloadRows from "../components/ProductDownloadRows.astro";
import { allDownloads } from "../lib/downloads";
import { formatKind } from "../lib/doc-meta";

const files = allDownloads();
const kinds = [...new Set(files.map((d) => d.kind))];
---

<Base title="Downloads · Huaming" description="Technical data, leaflets, operating instructions, and type-test reports. No email gate.">
  <main id="main">
    <div class="frame frame-default frame-type-sitereinhausen_introtext frame-layout-0">
      <div class="introtext bg-white">
        <div class="container">
          <Breadcrumb crumbs={[{ href: "/", label: "Home" }]} visible={false} />
          <div>
            <h1 class="h1ToIntro">Download Center</h1>
          </div>
          <div class="row">
            <div class="intro col-xl-12 col-xxl-10">
              <p>
                Technical data, leaflets, operating instructions, and type-test reports. No email gate.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="download-center">
        <div class="row">
          <div class="col-12">
            <div class="subnavi-big">
              <ul class="nav nav-tabs scrollbar scrollbar-horizontal scrollbar-black" id="downloadTabs" role="tablist">
                <li class="nav-item subnavi-big-button active">
                  <a class="nav-link active" href="#tabcontent-all" data-kind="" role="tab">
                    <h3>All</h3>
                  </a>
                </li>
                {
                  kinds.map((k, i) => (
                    <li class="nav-item subnavi-big-button">
                      <a class="nav-link" href={`#tabcontent-${i}`} data-kind={k} role="tab">
                        <h3>{formatKind(k)}</h3>
                      </a>
                    </li>
                  ))
                }
                <li class="nav-item subnavi-big-button">
                  <a class="nav-link" href="#tabcontent-search" data-kind="search" role="tab">
                    <h3>Search</h3>
                  </a>
                </li>
              </ul>
              <div class="down-button rotate180">
                <img
                  class="d-block d-s-none"
                  alt=""
                  src="/_assets/4fe0297b88c3f75f81bce57218e3ae92/Images/Icons/arrow-down-blue.svg"
                  width="24"
                  height="24"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="tab-content" id="downloadTabsContent">
          <div class="tab-pane fade show active" id="tabcontent-all" role="tabpanel">
            <div class="dc-filter-container">
              <form action="/downloads/" class="downloadCenter-filter" method="get">
                <div class="row">
                  <div class="downloadcenter-select-area col-12" id="downloadSelectWrap">
                    <div class="partial-select-area row">
                      <div class="dropdown-selectarea col-12 col-s-6 col-md-4 col-lg-3">
                        <select id="selectArea1-Products" name="kind" class="js-portfolio-selectarea">
                          <option value="">All kinds</option>
                          {
                            kinds.map((k) => (
                              <option value={k}>{formatKind(k)}</option>
                            ))
                          }
                        </select>
                      </div>
                    </div>
                  </div>
                  <div class="tx-kesearch-pi1 downloadCenterInputWrapper" hidden>
                    <div class="searchbox-grid col-12 col-lg-9 col-xxl-8">
                      <fieldset class="kesearch_searchbox">
                        <div class="kesearchbox">
                          <input
                            class="ke_search_sword_search"
                            type="search"
                            id="ke_search_sword"
                            name="q"
                            placeholder="Search"
                            value=""
                            minlength="4"
                          />
                          <div class="actions">
                            <span class="resetbutt">
                              <span class="resetButton">
                                <span>
                                  <img
                                    class="desktop-logo"
                                    alt="clear"
                                    src="/_assets/4fe0297b88c3f75f81bce57218e3ae92/Images/Icons/close.svg"
                                    width="25"
                                    height="24"
                                  />
                                </span>
                              </span>
                            </span>
                            <span class="submitbutt">
                              <button type="submit">
                                <img
                                  class="desktop-logo"
                                  alt="Search"
                                  src="/_assets/4fe0297b88c3f75f81bce57218e3ae92/Images/Icons/search_blue.svg"
                                  width="34"
                                  height="34"
                                />
                              </button>
                            </span>
                          </div>
                        </div>
                      </fieldset>
                    </div>
                  </div>
                </div>
              </form>
            </div>
            <ProductDownloadRows id="center" files={files} wrapCenter={false} />
          </div>
        </div>
      </div>
    </div>
    <InnerTeaser />
  </main>
</Base>

<script is:inline>
  (function () {
    var tabs = document.querySelectorAll("#downloadTabs a[data-kind]");
    var rows = document.querySelectorAll(".downloadcenter-row");
    var items = document.querySelectorAll(".downloadItem-link");
    var select = document.getElementById("selectArea1-Products");
    var searchWrap = document.querySelector(".downloadCenterInputWrapper");
    var selectWrap = document.getElementById("downloadSelectWrap");
    var input = document.getElementById("ke_search_sword");
    var reset = document.querySelector(".downloadCenterInputWrapper .resetButton");
    function apply(kind, q) {
      var searching = kind === "search";
      var needle = (q || "").trim().toLowerCase();
      items.forEach(function (el) {
        var hay = el.getAttribute("data-search") || "";
        var kindOk = !kind || searching || el.closest(".downloadcenter-row").getAttribute("data-filter-category") === kind;
        var textOk = !searching || needle.length < 4 || hay.indexOf(needle) !== -1;
        el.hidden = !(kindOk && textOk);
      });
      rows.forEach(function (r) {
        var any = r.querySelector(".downloadItem-link:not([hidden])");
        r.hidden = !any;
      });
      tabs.forEach(function (a) {
        var on = a.getAttribute("data-kind") === kind;
        a.classList.toggle("active", on);
        var li = a.closest(".subnavi-big-button");
        if (li) li.classList.toggle("active", on);
      });
      if (select) select.value = searching ? "" : kind || "";
      if (searchWrap) searchWrap.hidden = !searching;
      if (selectWrap) selectWrap.hidden = searching;
    }
    var kind = "";
    tabs.forEach(function (a) {
      a.addEventListener("click", function (e) {
        e.preventDefault();
        kind = a.getAttribute("data-kind") || "";
        apply(kind, input && input.value);
        if (kind === "search" && input) input.focus();
      });
    });
    if (select) {
      select.addEventListener("change", function () {
        kind = select.value;
        apply(kind, "");
      });
    }
    var form = document.querySelector(".downloadCenter-filter");
    if (form) {
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        kind = "search";
        apply(kind, input && input.value);
      });
    }
    if (input) {
      input.addEventListener("input", function () {
        if (kind === "search") apply("search", input.value);
      });
    }
    if (reset && input) {
      reset.addEventListener("click", function () {
        input.value = "";
        apply("search", "");
        input.focus();
      });
    }
  })();
</script>
