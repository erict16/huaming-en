---
import ProductCategory from "../../components/ProductCategory.astro";
import { groupCopy, productsInFamily, productsInGroup } from "../../lib/catalog";

const copy = groupCopy.oltc;
const vacuum = productsInFamily("oltc-vacuum");
const oil = productsInFamily("oltc-oil");
const other = productsInGroup("oltc").filter(
  (p) => p.family !== "oltc-vacuum" && p.family !== "oltc-oil",
);
---

<ProductCategory
  title={copy.title}
  description={copy.blurb}
  blurb={copy.blurb}
  crumbs={[
    { href: "/", label: "Home" },
    { href: "/products/", label: "Products" },
    { href: "/products/oltc/", label: copy.title },
  ]}
  items={productsInGroup("oltc")}
  tableGroups={[
    { className: "table-gradient", heading: "Vacuum", items: vacuum },
    { className: "table-white", heading: "Other on-load", items: other },
    { className: "table-grey", heading: "Oil", items: oil },
  ]}
/>
