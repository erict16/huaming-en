---
import Base from "../../layouts/Base.astro";
import ProductTabs from "../../components/ProductTabs.astro";
import { families, familyGroups, products } from "../../lib/catalog";
import { productImageSrc } from "../../lib/product-image";

function groupOf(familyId: string): "oltc" | "octc" | "accessories" {
  if ((familyGroups.oltc as readonly string[]).includes(familyId)) return "oltc";
  if ((familyGroups.octc as readonly string[]).includes(familyId)) return "octc";
  return "accessories";
}

const rows = products.map((p) => ({
  href: `/products/${p.slug}/`,
  name: p.name,
  intro: p.oneLiner,
  image: productImageSrc(p.slug),
  tab: groupOf(p.family),
  family: families.find((f) => f.id === p.family)?.name ?? "",
}));
---

<Base title="Types · Huaming" description="On-load tap changers, de-energized tap changers, motor drives, and accessories. Technical data as PDF.">
  <main id="main" class="hm-list">
    <div class="hm-wrap hm-list-intro">
      <h1>Types</h1>
      <p class="hm-list-lede">
        On-load and de-energized tap changers, plus motor drives and accessories. Technical data as PDF.
        Shanghai factory. Singapore headquarters.
      </p>
      <ProductTabs current="all" filter />
    </div>

    <div class="hm-wrap">
      <div class="hm-type-grid" id="type-grid">
        {
          rows.map((t) => (
            <a class="hm-type" href={t.href} data-tab={t.tab}>
              <div class="hm-thumb">
                {t.image ? <img src={t.image} alt="" width="600" height="414" /> : null}
              </div>
              <span class="hm-code">{t.name}</span>
              <span class="hm-one">{t.intro}</span>
            </a>
          ))
        }
      </div>
      <p class="hm-list-pdf">
        <a href="/downloads/">Technical data (PDF)</a>
        {" · "}
        <a href="/contact/">Singapore office</a>
      </p>
    </div>
  </main>
</Base>

<script is:inline>
  (function () {
    var tabs = document.querySelectorAll(".hm-tabs[data-filter='1'] a");
    var boxes = document.querySelectorAll("#type-grid .hm-type");
    if (!tabs.length) return;
    function show(id) {
      tabs.forEach(function (t) {
        t.classList.toggle("is-on", t.getAttribute("data-tab") === id);
      });
      boxes.forEach(function (b) {
        b.hidden = b.getAttribute("data-tab") !== id;
      });
    }
    tabs.forEach(function (tab) {
      tab.addEventListener("click", function (e) {
        e.preventDefault();
        show(tab.getAttribute("data-tab"));
      });
    });
    show("oltc");
  })();
</script>
