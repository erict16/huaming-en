---
import Base from "../../layouts/Base.astro";
import ProductBox from "../../components/ProductBox.astro";
import { families, products } from "../../lib/catalog";
import { productImageSrc } from "../../lib/product-image";
---

<Base title="Products · Huaming" description="On-load tap changers, de-energized tap changers, and motor drives.">
  <main id="main">
    <div class="stage">
      <div class="swiper-container stage-slider" data-loop="0" data-autoplay="0" data-autoplay-time="5000">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <div class="swiper-image"></div>
            <div class="stage-content container bg-gradient">
              <div class="text-container">
                <h2><p>Products</p></h2>
                <span class="light">
                  <p>
                    Three jobs: on-load tap changers, de-energized tap changers, and accessories (motor
                    drives, monitors). Vacuum is a technology inside OLTC, not a third family.
                  </p>
                </span>
              </div>
            </div>
          </div>
        </div>
        <StageControls />
      </div>
    </div>

    <div class="container">
      <p>
        <a href="/products/oltc/">OLTC</a>
        · OCTC · Accessories
      </p>
    </div>

    <div class="product-list-plugin">
      <div class="swiper-wrapper">
        {
          products.map((p) => (
            <ProductBox
              href={`/products/${p.slug}/`}
              name={p.name}
              intro={p.oneLiner}
              image={productImageSrc(p.slug)}
              facts={[families.find((f) => f.id === p.family)?.name ?? ""]}
            />
          ))
        }
      </div>
    </div>
  </main>
</Base>
