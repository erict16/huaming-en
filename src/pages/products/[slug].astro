---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProductBox from "../../components/ProductBox.astro";
import StageControls from "../../components/StageControls.astro";
import { familyById, productBySlug, products } from "../../lib/catalog";
import { allDownloads } from "../../lib/downloads";
import { formatKind, parseDocMeta } from "../../lib/doc-meta";
import { formatBytes } from "../../lib/format";
import { productImageSrc } from "../../lib/product-image";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const oltcIds = ["oltc-oil", "oltc-vacuum", "oltc-dry", "oltc-gas", "oltc-reactive", "regulator"];

const { slug } = Astro.params;
const product = productBySlug(slug!);
if (!product) throw new Error(`unknown type ${slug}`);
const photo = productImageSrc(product.slug);
const files = allDownloads().filter((d) => d.products.includes(product.slug));
const note =
  typeof (product as { note?: string }).note === "string" ? (product as { note: string }).note : null;
const noPdf = product.slug === "chvt" && files.length === 0;
const isOltc = oltcIds.includes(product.family);
const sameFamily = products.filter((p) => p.slug !== product.slug && p.family === product.family);
const oltcSiblings = isOltc
  ? products.filter(
      (p) => p.slug !== product.slug && p.family !== product.family && oltcIds.includes(p.family),
    )
  : [];
const related = [...sameFamily, ...oltcSiblings].slice(0, 6);
---

<Base title={`${product.name} · Huaming`} description={product.oneLiner}>
  <main id="main">
    <div class="product-detail-wrapper">
      <div class="introtext">
        <div class="container">
          <Breadcrumb
            crumbs={[
              { href: "/", label: "Home" },
              { href: "/products/", label: "Products" },
              ...(isOltc ? [{ href: "/products/oltc/", label: "On-load tap changers" }] : []),
            ]}
          />
          <h1>{product.name}</h1>
          <p>{product.oneLiner}</p>
        </div>
      </div>

      {
        photo ? (
          <div class="stage">
            <div class="swiper-container stage-slider" data-loop="0" data-autoplay="0" data-autoplay-time="5000">
              <div class="swiper-wrapper">
                <div class="swiper-slide">
                  <div class="swiper-image">
                    <img src={photo} alt={`${product.name} tap changer`} />
                  </div>
                </div>
              </div>
              <StageControls />
            </div>
          </div>
        ) : null
      }

      <div class="keyfacts bg-gradient">
        <div class="container">
          <div class="row">
            <div class="col-m-12 col-lg-4 offset-lg-1">
              <h2 class="headline">Facts</h2>
            </div>
            <div class="keyfact width-small icon-plus col-m-12 col-lg-6 offset-lg-1">
              <div class="key-facts">
                <ol
                  class="keyfacts-list row collapse-mobile-spec-number collapse-tablet-spec-number"
                  data-attr-collapse-mobile="5"
                  data-attr-collapse-tablet="5"
                >
                  {
                    product.ratings.map((r) => (
                      <li class="col-12 col-s-6 col-lg-6 white">
                        <div class="keyfact-headline">
                          <p></p>
                        </div>
                        <p>{r}</p>
                      </li>
                    ))
                  }
                </ol>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="product-registers-container">
        <div class="container">
          <h2 class="headline">Downloads</h2>
          {
            noPdf ? (
              <p>No English technical data PDF for CHVT on the live shop.</p>
            ) : files.length === 0 ? (
              <p>No brochure on this type yet.</p>
            ) : (
              <div class="download-center">
                <div class="downloadcenter-rows">
                  {files.map((d) => {
                    const meta = parseDocMeta(d.file, d.title);
                    return (
                      <div class="downloadcenter-row" data-filter-category={d.kind}>
                        <div class="col-xl-3 col-xxl-4 downloadcenter-row-name">{formatKind(d.kind)}</div>
                        <div class="download-set">
                          <a href={`/downloads/${d.file}`} class="downloadItem-link">
                            <div class="downloadItem">
                              <div class="downloadItem-label d-flex align-items-baseline">
                                <div class="download-name">{d.title}</div>
                              </div>
                              <div class="downloadItem-info">
                                {meta.docNo ? <span>{meta.docNo}</span> : null}
                                {meta.year ? <span>{meta.year}</span> : null}
                                <span>{formatBytes(d.bytes ?? 0)}</span>
                              </div>
                            </div>
                          </a>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )
          }
          {note ? <p>{note}</p> : null}
        </div>
      </div>

      {
        related.length ? (
          <div class="product-related-products">
            <div class="teaser_products container">
              <div class="row">
                <div class="swiper-container product-swiper col-12" id="teaserproduct-show">
                  <div class="swiper-controls-container">
                    <h2>Related types</h2>
                    <div class="swiper-controls">
                      <div class="swiper-button-prev swiper-button-prev-productteaserproduct-show">
                        <svg width="13" height="21" viewBox="0 0 13 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path
                            fill-rule="evenodd"
                            clip-rule="evenodd"
                            d="M9.26236 10.6805L-0.00410652 1.41408L1.41011 -0.0001297L12.1436 10.7334L1.3837 20.7315L0.0223022 19.2664L9.26236 10.6805Z"
                            fill="currentColor"
                          />
                        </svg>
                      </div>
                      <div class="swiper-button-next swiper-button-next-productteaserproduct-show">
                        <svg width="13" height="21" viewBox="0 0 13 21" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path
                            fill-rule="evenodd"
                            clip-rule="evenodd"
                            d="M9.26236 10.6805L-0.00410652 1.41408L1.41011 -0.0001297L12.1436 10.7334L1.3837 20.7315L0.0223022 19.2664L9.26236 10.6805Z"
                            fill="currentColor"
                          />
                        </svg>
                      </div>
                    </div>
                  </div>
                  <div class="swiper-wrapper">
                    {related.map((p) => (
                      <ProductBox
                        href={`/products/${p.slug}/`}
                        name={p.name}
                        intro={p.oneLiner}
                        image={productImageSrc(p.slug)}
                        facts={[familyById(p.family)?.name ?? ""]}
                      />
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ) : null
      }
    </div>
  </main>
</Base>
