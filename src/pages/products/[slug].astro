---
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProductBox from "../../components/ProductBox.astro";
import ProductCategory from "../../components/ProductCategory.astro";
import InnerTeaser from "../../components/InnerTeaser.astro";
import ProductRegisters from "../../components/ProductRegisters.astro";
import StageControls from "../../components/StageControls.astro";
import {
  families,
  familyById,
  familyGroups,
  groupCopy,
  keyfactParts,
  productBySlug,
  products,
  productsForListSlug,
} from "../../lib/catalog";
import { allDownloads } from "../../lib/downloads";
import { productImageSrc } from "../../lib/product-image";

export function getStaticPaths() {
  const productSlugs = new Set(products.map((p) => p.slug));
  const listIds = [...families.map((f) => f.id), "accessories"].filter((id) => !productSlugs.has(id));
  return [
    ...products.map((p) => ({ params: { slug: p.slug }, props: { kind: "pdp" as const } })),
    ...listIds.map((id) => ({ params: { slug: id }, props: { kind: "list" as const } })),
  ];
}

interface Props {
  kind: "pdp" | "list";
}

const { kind } = Astro.props as Props;
const slug = Astro.params.slug!;
const oltcIds = familyGroups.oltc as readonly string[];

let listTitle = "";
let listBlurb = "";
let listDesc = "";
let listItems = productsForListSlug(slug);
let listCrumbs: { href: string; label: string }[] = [];

if (kind === "list") {
  if (slug === "accessories") {
    listTitle = groupCopy.accessories.title;
    listBlurb = groupCopy.accessories.blurb;
    listDesc = listBlurb;
    listCrumbs = [
      { href: "/", label: "Home" },
      { href: "/products/", label: "Products" },
      { href: "/products/accessories/", label: listTitle },
    ];
  } else {
    const fam = familyById(slug);
    if (!fam) throw new Error(`unknown list ${slug}`);
    listTitle = fam.name;
    listBlurb = fam.blurb;
    listDesc = fam.blurb;
    listCrumbs = [
      { href: "/", label: "Home" },
      { href: "/products/", label: "Products" },
      ...(oltcIds.includes(slug) ? [{ href: "/products/oltc/", label: groupCopy.oltc.title }] : []),
      ...((familyGroups.accessories as readonly string[]).includes(slug)
        ? [{ href: "/products/accessories/", label: groupCopy.accessories.title }]
        : []),
      { href: `/products/${slug}/`, label: fam.name },
    ];
  }
}

const product = kind === "pdp" ? productBySlug(slug) : undefined;
if (kind === "pdp" && !product) throw new Error(`unknown type ${slug}`);
const photo = product ? productImageSrc(product.slug) : null;
const files = product ? allDownloads().filter((d) => d.products.includes(product.slug)) : [];
const note =
  product && typeof (product as { note?: string }).note === "string"
    ? (product as { note: string }).note
    : null;
const noPdf = product?.slug === "chvt" && files.length === 0;
const isOltc = product ? oltcIds.includes(product.family) : false;
const familyCrumb = product ? familyById(product.family) : undefined;
const sameFamily = product
  ? products.filter((p) => p.slug !== product.slug && p.family === product.family)
  : [];
const oltcSiblings =
  product && isOltc
    ? products.filter(
        (p) => p.slug !== product.slug && p.family !== product.family && oltcIds.includes(p.family),
      )
    : [];
const related = [...sameFamily, ...oltcSiblings].slice(0, 6);
---

{
  kind === "list" ? (
    <ProductCategory
      title={listTitle}
      description={listDesc}
      blurb={listBlurb}
      crumbs={listCrumbs}
      items={listItems}
    />
  ) : null
}

{
  kind === "pdp" && product ? (
<Base title={`${product.name} · Huaming`} description={product.oneLiner}>
  <main id="main" class="hm-pdp">
    <div class="product-detail-wrapper">
      <div class="hm-wrap hm-pdp-intro">
        <Breadcrumb
          crumbs={[
            { href: "/", label: "Home" },
            { href: "/products/", label: "Products" },
            ...(isOltc ? [{ href: "/products/oltc/", label: groupCopy.oltc.title }] : []),
            ...(product.family === "octc"
              ? [{ href: "/products/octc/", label: groupCopy.octc.title }]
              : []),
            ...((familyGroups.accessories as readonly string[]).includes(product.family)
              ? [{ href: "/products/accessories/", label: groupCopy.accessories.title }]
              : []),
            ...(familyCrumb && product.family !== "octc"
              ? [{ href: `/products/${product.family}/`, label: familyCrumb.name }]
              : []),
          ]}
        />
        <h1>{product.name}</h1>
        {familyCrumb ? <p class="hm-pdp-kicker">{familyCrumb.name}</p> : null}
        <p class="hm-pdp-lede">{product.oneLiner}</p>
      </div>

      {
        photo ? (
          <div class="stage">
            <div class="swiper-container stage-slider" data-loop="0" data-autoplay="0" data-autoplay-time="5000">
              <div class="swiper-wrapper">
                <div class="swiper-slide">
                  <div class="swiper-image">
                    <img src={photo} alt={`${product.name} tap changer`} width="600" height="414" />
                  </div>
                </div>
              </div>
              <StageControls />
            </div>
          </div>
        ) : null
      }

      <div class="hm-wrap hm-spec">
        <h2>Facts</h2>
        <div class="hm-spec-scroll">
          <table>
            <thead>
              <tr>
                <th>Parameter</th>
                <th>Value</th>
              </tr>
            </thead>
            <tbody>
              {product.ratings.map((r, i) => {
                const fact = keyfactParts(r, familyCrumb?.name ?? "", i);
                return (
                  <tr>
                    <th scope="row">{fact.label || "From the plate"}</th>
                    <td>{fact.body}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      <div class="hm-wrap hm-pdp-regs">
        <ProductRegisters slug={product.slug} ratings={product.ratings} files={files} noPdf={noPdf} note={note} />
      </div>

      {
        related.length ? (
          <div class="hm-wrap hm-pdp-related">
            <h2>Related types</h2>
            <div class="hm-type-grid">
              {related.map((p) => (
                <ProductBox
                  href={`/products/${p.slug}/`}
                  name={p.name}
                  intro={p.oneLiner}
                  image={productImageSrc(p.slug)}
                  facts={[familyById(p.family)?.name ?? ""]}
                />
              ))}
            </div>
          </div>
        ) : null
      }

      <p class="hm-wrap hm-pdp-also">
        <a href="/downloads/">Technical data (PDF)</a>
        {" · "}
        <a href="/contact/">Singapore office</a>
        {" · "}
        <a href="/products/">All types</a>
      </p>
    </div>
    <InnerTeaser />
  </main>
</Base>
  ) : null
}
