---
import Base from "../layouts/Base.astro";
import { productBySlug } from "../lib/catalog";
import { news } from "../lib/news";
import { productImageSrc } from "../lib/product-image";

const strip = [
  { slug: "cv2", kind: "Vacuum OLTC" },
  { slug: "cm2", kind: "Vacuum, CM envelope" },
  { slug: "shzv", kind: "Vacuum OLTC" },
  { slug: "hwv", kind: "On-tank vacuum" },
  { slug: "wsl", kind: "De-energized, cage" },
  { slug: "cma7", kind: "Motor drive" },
]
  .map((row) => {
    const p = productBySlug(row.slug);
    if (!p) return null;
    return { ...row, name: p.name, href: `/products/${p.slug}/`, src: productImageSrc(p.slug) };
  })
  .filter((row): row is NonNullable<typeof row> => Boolean(row));

const homeNews = news.slice(0, 2);
const heroSrc = productImageSrc("cm2") ?? "/images/products/cm2.png";
---

<Base title="Huaming — tap changers for power transformers">
  <main id="main" class="hm-home">
    <section class="hm-hero" aria-label="Featured type">
      <figure>
        <img src={heroSrc} alt="CM2 vacuum on-load tap changer" width="600" height="414" />
      </figure>
    </section>

    <section class="hm-ribbon">
      <div class="hm-ribbon-inner">
        <div>
          <h1>Tap changers for power transformers</h1>
          <p class="hm-lede">
            Vacuum CM2 in the oil CM envelope. On-load and de-energized types across the range. Shanghai
            factory. Singapore headquarters.
          </p>
        </div>
        <ul class="hm-meta">
          <li>Typical lead time 4–6 weeks</li>
          <li><a href="/downloads/">Technical data (PDF)</a></li>
          <li><a href="mailto:intl@huaming.com">intl@huaming.com</a></li>
        </ul>
      </div>
    </section>

    <section class="hm-strip" aria-label="Types">
      <div class="hm-wrap">
        <h2>Types</h2>
        <div class="hm-row">
          {
            strip.map((t) => (
              <a class="hm-cell" href={t.href}>
                <div class="hm-thumb">
                  {t.src ? (
                    <img src={t.src} alt="" width="600" height="414" />
                  ) : null}
                </div>
                <span class="hm-code">{t.name}</span>
                <span class="hm-one">{t.kind}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="hm-news" aria-label="News">
      <div class="hm-wrap">
        <h2>News</h2>
        <ul>
          {
            homeNews.map((item, i) => (
              <li>
                <span class="hm-n">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <a href={`/news/${item.slug}/`}>{item.title}</a>
                  <p>{item.summary}</p>
                </div>
                <time datetime={item.date}>{item.date}</time>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Base>
