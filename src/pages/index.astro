---
import Home from "../layouts/Home.astro";
import HeroWaves from "../components/HeroWaves.astro";
import { offices, productBySlug } from "../lib/catalog";
import { news } from "../lib/news";
import { productImageSrc } from "../lib/product-image";

const shanghai = offices.find((o) => o.id === "shanghai");
const singapore = offices.find((o) => o.id === "singapore");

const featured = ["cv2", "cm2", "shzv", "hwv", "wsl", "cma7"]
  .map((slug) => {
    const p = productBySlug(slug);
    if (!p) return null;
    return {
      slug,
      name: p.name,
      blurb: p.oneLiner,
      href: `/products/${p.slug}/`,
      src: productImageSrc(p.slug),
    };
  })
  .filter((row): row is NonNullable<typeof row> => Boolean(row));

const homeNews = news.slice(0, 2);
---

<Home title="Huaming — tap changers for power transformers">
  <main id="main">
    <section class="relative min-h-[32rem] overflow-hidden bg-paper text-ink lg:min-h-[36rem]">
      <HeroWaves />
      <div
        class="pointer-events-none absolute inset-y-0 left-0 z-[1] w-[min(46rem,62%)] bg-gradient-to-r from-paper via-paper/95 to-transparent max-[800px]:w-full max-[800px]:bg-gradient-to-b"
        aria-hidden="true"
      >
      </div>
      <div class="relative z-[2] mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-xl py-16 sm:py-20 lg:py-24">
          <p class="text-xs font-medium uppercase tracking-[0.12em] text-mute">
            Shanghai Huaming Power Equipment
          </p>
          <h1 class="mt-2 max-w-[12ch] text-5xl font-semibold tracking-tight text-navy sm:text-6xl sm:leading-[1.08]">
            Welcome to Huaming
          </h1>
          <p class="mt-5 max-w-xl text-lg leading-7 text-ink sm:text-xl sm:leading-8">
            We make tap changers for power transformers. The factory is in Putuo, Shanghai. International
            headquarters opened in Singapore in 2025.
          </p>
          <p class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-steel">
            <a class="hover:underline hover:underline-offset-[0.16em] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel" href="/products/">Products</a>
            <a class="hover:underline hover:underline-offset-[0.16em] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel" href="/downloads/">Downloads</a>
            <a class="hover:underline hover:underline-offset-[0.16em] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel" href="/contact/">Contact</a>
          </p>
        </div>
      </div>
    </section>

    <figure class="mx-auto max-w-7xl px-6 pt-10 lg:px-8 lg:pt-12">
      <img
        class="block h-auto max-h-[28rem] w-full bg-paper object-cover object-center"
        src="/images/00_HuaMing/about/about-photo.jpg"
        alt="Shanghai factory, Putuo."
      />
      <figcaption class="pt-3 pb-2 text-xs text-mute">
        Shanghai factory, No. 977 Tongpu Road, Putuo.
      </figcaption>
    </figure>

    <section class="mx-auto max-w-7xl px-6 py-16 lg:px-8 lg:py-24" aria-label="Factory and headquarters">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <article class="flex flex-col bg-paper px-8 py-10 lg:px-10 lg:py-12">
          <p class="text-xs font-medium uppercase tracking-[0.12em] text-mute">Factory</p>
          <h2 class="mt-1 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Shanghai</h2>
          <p class="mt-6 font-semibold text-ink">
            {shanghai?.name ?? "Shanghai Huaming Power Equipment Co., Ltd."}
          </p>
          {
            shanghai ? (
              shanghai.lines.map((line) => <p class="mt-1.5 text-base leading-6 text-ink">{line}</p>)
            ) : (
              <p class="mt-1.5 text-base leading-6 text-ink">
                No. 977 Tongpu Road, Putuo District, Shanghai 200333, China.
              </p>
            )
          }
          <p class="mt-1.5 text-base leading-6 text-ink">
            Founded 1989. Listed Shenzhen 002270.SZ in 2015. CNAS laboratory since 2009.
          </p>
          <p class="mt-auto pt-10">
            <a
              class="font-semibold text-steel hover:underline hover:underline-offset-[0.16em] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel"
              href="/about/"
            >
              Company
            </a>
          </p>
        </article>
        <article class="flex flex-col bg-navy px-8 py-10 text-white lg:px-10 lg:py-12">
          <p class="text-xs font-medium uppercase tracking-[0.12em] text-white/85">
            International headquarters
          </p>
          <h2 class="mt-1 text-3xl font-semibold tracking-tight text-white sm:text-4xl">Singapore</h2>
          <p class="mt-6 font-semibold">
            {singapore?.name ?? "Huaming Power Equipment Singapore Pte. Ltd"}
          </p>
          {
            singapore
              ? singapore.lines.map((line) => <p class="mt-1.5 text-base leading-6">{line}</p>)
              : null
          }
          <p class="mt-1.5 text-base leading-6">Opened 29 April 2025.</p>
          <p class="mt-1.5 text-base leading-6">
            <a
              class="font-semibold text-white hover:underline hover:underline-offset-[0.16em] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              href="mailto:intl@huaming.com"
            >
              intl@huaming.com
            </a>
          </p>
          <p class="mt-auto pt-10">
            <a
              class="font-semibold text-white hover:underline hover:underline-offset-[0.16em] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              href="/contact/"
            >
              Write Singapore
            </a>
          </p>
        </article>
      </div>
    </section>

    <section class="bg-white py-16 lg:py-24" aria-label="Featured Products">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <h2 class="text-4xl font-semibold tracking-tight text-navy sm:text-5xl">Featured Products</h2>
        <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {
            featured.map((t) => (
              <article class="flex flex-col gap-3">
                <a class="block aspect-[3/2] bg-paper px-4 py-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy" href={t.href} tabindex="-1">
                  {t.src ? (
                    <img class="size-full object-contain object-center" src={t.src} alt="" width="600" height="400" />
                  ) : null}
                </a>
                <h3 class="text-xl font-semibold tracking-tight text-ink">{t.name}</h3>
                <p class="text-base leading-6 text-ink">{t.blurb}</p>
                <a
                  class="text-sm font-semibold text-steel hover:underline hover:underline-offset-[0.16em] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-steel"
                  href={t.href}
                >
                  Show product
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-paper py-16 lg:py-24" aria-label="Latest news">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-mute">News</p>
        <h2 class="mt-2 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Latest news</h2>
        <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-2">
          {
            homeNews.map((item) => (
              <article class="flex flex-col bg-white p-8 ring-1 ring-black/5">
                <time class="text-sm text-mute" datetime={item.date}>
                  {item.date}
                </time>
                <h3 class="mt-3 text-xl font-semibold tracking-tight text-navy">
                  <a
                    class="hover:underline hover:underline-offset-[0.16em] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy"
                    href={`/news/${item.slug}/`}
                  >
                    {item.title}
                  </a>
                </h3>
                <p class="mt-3 text-base leading-6 text-ink">{item.summary}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Home>
