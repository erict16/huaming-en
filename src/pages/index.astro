---
import Base from "../layouts/Base.astro";
import HeroWaves from "../components/HeroWaves.astro";
import { offices, productBySlug } from "../lib/catalog";
import { news } from "../lib/news";
import { productImageSrc } from "../lib/product-image";

const shanghai = offices.find((o) => o.id === "shanghai");
const singapore = offices.find((o) => o.id === "singapore");

const featured = ["cv2", "cm2", "shzv", "hwv", "wsl", "cma7"]
  .map((slug) => {
    const p = productBySlug(slug);
    if (!p) return null;
    return {
      slug,
      name: p.name,
      blurb: p.oneLiner,
      href: `/products/${p.slug}/`,
      src: productImageSrc(p.slug),
    };
  })
  .filter((row): row is NonNullable<typeof row> => Boolean(row));

const homeNews = news.slice(0, 2);
---

<Base title="Huaming — tap changers for power transformers">
  <main id="main" class="hm-home">
    <section class="hm-stage">
      <HeroWaves />
      <div class="hm-wrap">
        <div class="hm-stage-copy">
          <p class="hm-kicker">Shanghai Huaming Power Equipment</p>
          <h1>Welcome to Huaming</h1>
          <p class="hm-lede">
            We make tap changers for power transformers. The factory is in Putuo, Shanghai. International
            headquarters opened in Singapore in 2025.
          </p>
          <p class="hm-acts">
            <a href="/products/">Products</a>
            <a href="/downloads/">Downloads</a>
            <a href="/contact/">Contact</a>
          </p>
        </div>
      </div>
    </section>
    <figure class="hm-stage-photo">
      <img
        src="/images/00_HuaMing/about/about-photo.jpg"
        alt="Shanghai factory, Putuo."
      />
      <figcaption>Shanghai factory, No. 977 Tongpu Road, Putuo.</figcaption>
    </figure>

    <section class="hm-homes" aria-label="Factory and headquarters">
      <article class="hm-home-factory">
        <p class="hm-place">Factory</p>
        <h2>Shanghai</h2>
        <p class="hm-legal">{shanghai?.name ?? "Shanghai Huaming Power Equipment Co., Ltd."}</p>
        {
          shanghai ? (
            shanghai.lines.map((line) => (
              <p>{line}</p>
            ))
          ) : (
            <p>No. 977 Tongpu Road, Putuo District, Shanghai 200333, China.</p>
          )
        }
        <p>Founded 1989. Listed Shenzhen 002270.SZ in 2015. CNAS laboratory since 2009.</p>
        <p class="hm-col-cta"><a href="/about/">Company</a></p>
      </article>
      <article class="hm-home-hq">
        <p class="hm-place">International headquarters</p>
        <h2>Singapore</h2>
        <p class="hm-legal">{singapore?.name ?? "Huaming Power Equipment Singapore Pte. Ltd"}</p>
        {
          singapore
            ? singapore.lines.map((line) => (
                <p>{line}</p>
              ))
            : null
        }
        <p>Opened 29 April 2025.</p>
        <p><a href="mailto:intl@huaming.com">intl@huaming.com</a></p>
        <p class="hm-col-cta"><a href="/contact/">Write Singapore</a></p>
      </article>
    </section>

    <section class="hm-feat" aria-label="Featured Products">
      <div class="hm-wrap">
        <div class="hm-feat-head">
          <h2>Featured Products</h2>
          <div class="hm-feat-nav">
            <button type="button" class="hm-feat-prev" aria-label="Previous products">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m15 18-6-6 6-6"></path>
              </svg>
            </button>
            <button type="button" class="hm-feat-next" aria-label="Next products">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </button>
          </div>
        </div>
        <div class="hm-feat-track">
          {
            featured.map((t) => (
              <article class="hm-feat-card">
                <a class="hm-feat-still" href={t.href} tabindex="-1">
                  {t.src ? <img src={t.src} alt="" width="600" height="400" /> : null}
                </a>
                <h3>{t.name}</h3>
                <p>{t.blurb}</p>
                <a class="hm-feat-go" href={t.href}>Show product</a>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <script is:inline>
      (function () {
        var track = document.querySelector(".hm-feat-track");
        var prev = document.querySelector(".hm-feat-prev");
        var next = document.querySelector(".hm-feat-next");
        if (!track || !prev || !next) return;
        function step() {
          var card = track.querySelector(".hm-feat-card");
          if (!card) return 0;
          var styles = getComputedStyle(track);
          var gap = parseFloat(styles.columnGap || styles.gap) || 0;
          return card.getBoundingClientRect().width + gap;
        }
        function sync() {
          var max = track.scrollWidth - track.clientWidth - 4;
          prev.disabled = track.scrollLeft <= 4;
          next.disabled = track.scrollLeft >= max;
        }
        prev.addEventListener("click", function () {
          track.scrollBy({ left: -step(), behavior: "smooth" });
        });
        next.addEventListener("click", function () {
          track.scrollBy({ left: step(), behavior: "smooth" });
        });
        track.addEventListener("scroll", sync, { passive: true });
        window.addEventListener("resize", sync);
        sync();
      })();
    </script>

    <section class="hm-news" aria-label="Latest news">
      <div class="hm-wrap">
        <h2>Latest news</h2>
        <div class="hm-news-blocks">
          {
            homeNews.map((item) => (
              <article>
                <time datetime={item.date}>{item.date}</time>
                <h3>
                  <a href={`/news/${item.slug}/`}>{item.title}</a>
                </h3>
                <p>{item.summary}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
</Base>
