---
import Base from "../layouts/Base.astro";
import { offices, productBySlug } from "../lib/catalog";
import { news } from "../lib/news";
import { productImageSrc } from "../lib/product-image";

const shanghai = offices.find((o) => o.id === "shanghai");
const singapore = offices.find((o) => o.id === "singapore");

const strip = [
  { slug: "cv2", kind: "Vacuum OLTC" },
  { slug: "cm2", kind: "Vacuum, CM envelope" },
  { slug: "shzv", kind: "Vacuum OLTC" },
  { slug: "hwv", kind: "On-tank vacuum" },
  { slug: "wsl", kind: "De-energized, cage" },
  { slug: "cma7", kind: "Motor drive" },
]
  .map((row) => {
    const p = productBySlug(row.slug);
    if (!p) return null;
    return { ...row, name: p.name, href: `/products/${p.slug}/`, src: productImageSrc(p.slug) };
  })
  .filter((row): row is NonNullable<typeof row> => Boolean(row));

const homeNews = news.slice(0, 2);
---

<Base title="Huaming — tap changers for power transformers">
  <main id="main" class="hm-home">
    <section class="hm-welcome">
      <div>
        <p class="hm-kicker">Shanghai Huaming Power Equipment</p>
        <h1>Welcome to Huaming</h1>
        <p class="hm-lede">
          We make tap changers for power transformers. The factory is in Putuo, Shanghai. International
          headquarters opened in Singapore in 2025.
        </p>
        <p class="hm-acts">
          <a href="/about/">Company</a>
          <a href="mailto:intl@huaming.com">intl@huaming.com</a>
          <a href="/downloads/">Technical data (PDF)</a>
        </p>
      </div>
      <figure>
        <img
          src="/images/00_HuaMing/about/about-photo.jpg"
          alt="Shanghai factory, Putuo."
        />
        <figcaption>Shanghai factory, No. 977 Tongpu Road, Putuo.</figcaption>
      </figure>
    </section>

    <section class="hm-homes" aria-label="Factory and headquarters">
      <article class="hm-home-factory">
        <p class="hm-place">Factory</p>
        <h2>Shanghai</h2>
        {
          shanghai ? (
            <>
              {shanghai.lines.map((line) => (
                <p>{line}</p>
              ))}
              <p>Founded 1989. Listed Shenzhen 002270.SZ in 2015. CNAS laboratory since 2009.</p>
            </>
          ) : (
            <p>No. 977 Tongpu Road, Putuo District, Shanghai 200333, China.</p>
          )
        }
        <p><a href="/about/">Company</a></p>
      </article>
      <article class="hm-home-hq">
        <p class="hm-place">International headquarters</p>
        <h2>Singapore</h2>
        {
          singapore ? (
            <>
              <p>{singapore.name}</p>
              {singapore.lines.map((line) => (
                <p>{line}</p>
              ))}
              <p>
                Opened 29 April 2025. Mail:{" "}
                <a href="mailto:intl@huaming.com">intl@huaming.com</a>.
              </p>
            </>
          ) : (
            <p>
              Mail: <a href="mailto:intl@huaming.com">intl@huaming.com</a>
            </p>
          )
        }
        <p><a href="/contact/">Write Singapore</a></p>
      </article>
    </section>

    <section class="hm-strip" aria-label="Latest products">
      <div class="hm-wrap">
        <h2>Latest products</h2>
        <div class="hm-row">
          {
            strip.map((t) => (
              <a class="hm-cell" href={t.href}>
                <div class="hm-thumb">
                  {t.src ? <img src={t.src} alt="" width="600" height="414" /> : null}
                </div>
                <span class="hm-code">{t.name}</span>
                <span class="hm-one">{t.kind}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="hm-news" aria-label="News">
      <div class="hm-wrap">
        <h2>News</h2>
        <ul>
          {
            homeNews.map((item, i) => (
              <li>
                <span class="hm-n">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <a href={`/news/${item.slug}/`}>{item.title}</a>
                  <p>{item.summary}</p>
                </div>
                <time datetime={item.date}>{item.date}</time>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
</Base>
