---
import Base from "../layouts/Base.astro";
import InnerTeaser from "../components/InnerTeaser.astro";
---

<Base title="404 · Huaming" description="This page is not on the English catalogue.">
  <main id="main">
    <div class="frame frame-default frame-type-sitereinhausen_mediaparallax frame-layout-0">
      <div class="textmedia-parallax color-blue">
        <div class="parallax-bg"></div>
        <div class="background image-bg gradient-bg">
          <div class="media-content">
            <div class="container">
              <div class="row">
                <div class="col-12 col-s-11 col-sm-10 col-md-6 col-lg-5 offset-lg-1">
                  <h2>
                    404
                    <br />
                    This page is not on the English catalogue.
                  </h2>
                  <div class="copy-content">
                    <p>The URL may be wrong, or the page moved. Types and PDFs are still on the catalogue.</p>
                  </div>
                  <a href="/" class="cta cta-outline">Home</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="frame frame-default frame-type-sitereinhausen_text frame-layout-0">
      <div class="text-module bg-white" style="position: relative;">
        <div class="container">
          <div class="row">
            <div class="col-12 col-sm-6 col-lg-5 offset-lg-1">
              <h2 class="headline mb-sm-0">Types and PDFs are still on the catalogue.</h2>
            </div>
            <div class="col-12 col-sm-6 col-lg-5">
              <div class="text-wrapper">
                <p>The URL may be wrong, or the page moved. Search still works.</p>
                <a href="/search/" class="cta cta-outline mb-0">Search</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <InnerTeaser />
  </main>
</Base>
