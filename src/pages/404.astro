---
import Base from "../layouts/Base.astro";
import StageControls from "../components/StageControls.astro";
---

<Base title="404 · Huaming" description="This page is not on the English catalogue.">
  <main id="main">
    <div class="stage">
      <div class="swiper-container stage-slider" data-loop="0" data-autoplay="0" data-autoplay-time="5000">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <div class="swiper-image"></div>
            <div class="stage-content container bg-gradient">
              <div class="text-container">
                <h2><p>404</p></h2>
                <span class="light"><p>This page is not on the English catalogue.</p></span>
                <a href="/" class="link-download">Home</a>
              </div>
            </div>
          </div>
        </div>
        <StageControls />
      </div>
    </div>
  </main>
</Base>
