---
import Base from "../../layouts/Base.astro";
import InnerTeaser from "../../components/InnerTeaser.astro";
import { offices } from "../../lib/catalog";

const shanghai = offices.find((o) => o.id === "shanghai");
const singapore = offices.find((o) => o.id === "singapore");
---

<Base title="Imprint · Huaming" description="Legal notice for the English catalogue.">
  <main id="main" class="hm-list">
    <div class="hm-wrap hm-list-intro">
      <h1>Imprint</h1>
      <p class="hm-list-lede">Shanghai is the factory. Singapore is the international headquarters.</p>
    </div>
    <div class="hm-wrap hm-article-body">
      {
        shanghai ? (
          <>
            <p>
              <strong>{shanghai.name}</strong>
            </p>
            <p>
              {shanghai.lines.map((line) => (
                <>
                  {line}
                  <br />
                </>
              ))}
              {shanghai.creditCode ? <>Credit code {shanghai.creditCode}</> : null}
            </p>
          </>
        ) : null
      }
      {
        singapore ? (
          <>
            <p>
              <strong>{singapore.name}</strong>
            </p>
            <p>
              {singapore.role}.
              {singapore.lines.map((line) => (
                <>
                  <br />
                  {line}
                </>
              ))}
            </p>
          </>
        ) : null
      }
      <p>
        Email: <a href="mailto:intl@huaming.com">intl@huaming.com</a>
      </p>
      {
        shanghai?.web ? (
          <p>
            Web:{" "}
            <a href={shanghai.web} target="_blank" rel="noreferrer">
              huaming.com
            </a>
          </p>
        ) : null
      }
    </div>
    <InnerTeaser />
  </main>
</Base>
