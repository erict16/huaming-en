---
import Base from "../../layouts/Base.astro";
import InnerTeaser from "../../components/InnerTeaser.astro";
---

<Base title="Privacy · Huaming" description="This catalogue is a static site. Forms do not post to a Huaming server.">
  <main id="main" class="hm-list">
    <div class="hm-wrap hm-list-intro">
      <h1>Privacy</h1>
      <p class="hm-list-lede">This catalogue is a static site. Forms do not post to a Huaming server.</p>
    </div>
    <div class="hm-wrap hm-article-body">
      <p>Search and contact forms do not post to a Huaming server.</p>
      <p>
        If you write to <a href="mailto:intl@huaming.com">intl@huaming.com</a>, that mail goes to the
        international headquarters in Singapore.
      </p>
    </div>
    <InnerTeaser />
  </main>
</Base>
